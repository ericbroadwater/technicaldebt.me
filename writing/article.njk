---
pagination:
  data: articles
  size: 1
  alias: article
permalink: /writing/{{ article.slug }}/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-W43C7J9H');</script>
<!-- End Google Tag Manager -->
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ article.seoTitle }}</title>
<meta name="description" content="{{ article.metaDescription }}">
<link rel="canonical" href="https://technicaldebt.me/writing/{{ article.slug }}/">

<!-- Open Graph -->
<meta property="og:type" content="article">
<meta property="og:title" content="{{ article.seoTitle }}">
<meta property="og:description" content="{{ article.metaDescription }}">
<meta property="og:url" content="https://technicaldebt.me/writing/{{ article.slug }}/">
<meta property="og:image" content="{{ article.ogImage if article.ogImage else 'https://technicaldebt.me/images/egb-amsterdam.jpg' }}">
<meta property="og:site_name" content="technicaldebt.me">
<meta property="article:published_time" content="{{ article.publishDate }}">
<meta property="article:author" content="Eric Broadwater">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ article.seoTitle }}">
<meta name="twitter:description" content="{{ article.metaDescription }}">
<meta name="twitter:image" content="{{ article.ogImage if article.ogImage else 'https://technicaldebt.me/images/egb-amsterdam.jpg' }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-96x96.png" sizes="96x96" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400;500&family=Unbounded:wght@300;400&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --warm-white: #f7f2eb;
  --cream: #ede6d8;
  --night: #0d1a2e;
  --ocean: #1b3a5c;
  --pacific: #2e6da4;
  --horizon: #e8823a;
  --gold: #d4a853;
  --stone: #8a7968;
  --rule: #d4c9b8;
}

html {
  background: var(--warm-white);
  color: var(--night);
  font-family: 'Cormorant Garamond', serif;
  font-size: 18px;
  scroll-behavior: smooth;
}

body { min-height: 100vh; overflow-x: hidden; }

/* ── Nav ── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 28px 56px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(247, 242, 235, 0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--rule);
}

.nav-domain {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  font-weight: 300;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--stone);
  text-decoration: none;
  transition: color 0.3s;
}
.nav-domain:hover { color: var(--horizon); }

.nav-links {
  display: flex;
  gap: 40px;
  list-style: none;
}

.nav-links a {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  font-weight: 300;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--stone);
  text-decoration: none;
  transition: color 0.3s ease;
}
.nav-links a:hover { color: var(--horizon); }

/* ── Article layout ── */
.article-wrapper {
  max-width: 720px;
  margin: 0 auto;
  padding: 140px 40px 120px;
}

/* ── Header ── */
.article-header {
  margin-bottom: 56px;
  padding-bottom: 40px;
  border-bottom: 1px solid var(--rule);
}

.article-eyebrow {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
}

.back-link {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  font-weight: 300;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--stone);
  text-decoration: none;
  transition: color 0.2s;
}
.back-link:hover { color: var(--horizon); }

.eyebrow-divider {
  width: 1px;
  height: 12px;
  background: var(--rule);
}

.article-date {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  font-weight: 300;
  letter-spacing: 0.2em;
  color: var(--stone);
}

.article-title {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1.1;
  color: var(--night);
  letter-spacing: -0.01em;
  margin-bottom: 24px;
}

.article-summary {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: clamp(18px, 1.8vw, 24px);
  font-weight: 300;
  line-height: 1.5;
  color: var(--ocean);
  border-left: 2px solid var(--horizon);
  padding-left: 20px;
  margin-bottom: 28px;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.topic-tag {
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  font-weight: 400;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--pacific);
  border: 1px solid var(--pacific);
  padding: 4px 10px;
}

/* ── Hero image ── */
.article-hero {
  position: relative;
  margin-bottom: 2.5em;
  width: fit-content;
}

.article-hero img {
  display: block;
  width: 100%;
  max-height: 420px;
  object-fit: cover;
  border: 2px solid var(--rule);
  position: relative;
  z-index: 1;
}

.article-hero::after {
  content: '';
  position: absolute;
  top: 8px;
  left: 8px;
  right: -8px;
  bottom: -8px;
  border: 2px solid var(--horizon);
  z-index: 0;
}

/* ── Body rich text ── */
.article-body {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(17px, 1.5vw, 21px);
  font-weight: 300;
  line-height: 1.8;
  color: var(--night);
}

.article-body .article-h1 {
  font-weight: 600;
  font-size: clamp(26px, 3vw, 40px);
  line-height: 1.15;
  margin: 48px 0 20px;
  letter-spacing: -0.01em;
}

.article-body .article-h2 {
  font-weight: 600;
  font-size: clamp(22px, 2.4vw, 32px);
  line-height: 1.2;
  margin: 44px 0 16px;
  letter-spacing: -0.01em;
}

.article-body .article-h3 {
  font-weight: 600;
  font-size: clamp(18px, 1.8vw, 24px);
  color: var(--ocean);
  margin: 36px 0 12px;
}

.article-body .article-p { margin-bottom: 24px; }

.article-body .article-blockquote {
  border-left: 2px solid var(--horizon);
  padding: 4px 0 4px 24px;
  margin: 32px 0;
  font-style: italic;
  color: var(--ocean);
  font-size: clamp(19px, 1.8vw, 24px);
}

.article-body .article-blockquote p { margin: 0; }

.article-body .article-rule {
  border: none;
  border-top: 1px solid var(--rule);
  margin: 48px 0;
}

.article-body .article-ul,
.article-body .article-ol {
  padding-left: 28px;
  margin-bottom: 24px;
}

.article-body .article-ul li,
.article-body .article-ol li { margin-bottom: 8px; }

.article-body .article-link {
  color: var(--pacific);
  text-decoration: underline;
  text-decoration-color: rgba(46, 109, 164, 0.4);
  text-underline-offset: 3px;
  transition: color 0.2s, text-decoration-color 0.2s;
}
.article-body .article-link:hover {
  color: var(--horizon);
  text-decoration-color: var(--horizon);
}

/* ── Video embed ── */
.article-video { margin: 48px 0; }

.video-container {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  background: var(--night);
}

.video-container iframe {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  border: none;
}

.video-caption {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  font-weight: 300;
  letter-spacing: 0.15em;
  color: var(--stone);
  margin-top: 12px;
  text-transform: uppercase;
}

/* ── Author byline ── */
.article-author {
  margin-top: 64px;
  padding-top: 32px;
  border-top: 1px solid var(--rule);
  display: flex;
  align-items: flex-start;
  gap: 20px;
}

.author-label {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  font-weight: 300;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--stone);
  white-space: nowrap;
  padding-top: 2px;
}

.author-name {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
  font-size: 18px;
  color: var(--night);
  margin-bottom: 4px;
}

.author-bio {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 300;
  font-size: 15px;
  color: var(--stone);
  line-height: 1.5;
}

/* ── Footer ── */
footer {
  border-top: 1px solid var(--rule);
  padding: 32px 56px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-copy {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  font-weight: 300;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #b8a898;
}

/* ── Responsive ── */
@media (max-width: 900px) {
  nav { padding: 24px 28px; }
  .nav-links { gap: 24px; }
  .article-wrapper { padding: 120px 28px 80px; }
  footer { flex-direction: column; gap: 12px; padding: 32px; text-align: center; }
}

@media (max-width: 480px) {
  .nav-links { display: none; }
  .article-wrapper { padding: 100px 20px 60px; }
}
</style>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W43C7J9H"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<nav>
  <a href="/" class="nav-domain">technicaldebt.me</a>
  <ul class="nav-links">
    <li><a href="/#work">Work</a></li>
    <li><a href="/#basketdog">Basketdog</a></li>
    <li><a href="/#writing">Writing</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
</nav>

<main class="article-wrapper">

  <header class="article-header">
    <div class="article-eyebrow">
      <a href="/#writing" class="back-link">← Writing</a>
      {% if article.publishDate %}
      <div class="eyebrow-divider"></div>
      <span class="article-date">{{ article.publishDate | readableDate }}</span>
      {% endif %}
    </div>

    {% if article.ogImage %}
    <div class="article-hero">
      <img src="{{ article.ogImage }}" alt="{{ article.title }}" loading="lazy">
    </div>
    {% endif %}

    <h1 class="article-title">{{ article.title }}</h1>

    {% if article.summary %}
    <p class="article-summary">{{ article.summary }}</p>
    {% endif %}

    {% if article.topics.length %}
    <div class="article-meta">
      {% for topic in article.topics %}
      <span class="topic-tag">{{ topic.name }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </header>

  {% if article.videoUrl %}
  <div class="article-video">
    <div class="video-container">
      <iframe src="{{ article.videoUrl }}" allowfullscreen></iframe>
    </div>
    {% if article.videoCaption %}
    <p class="video-caption">{{ article.videoCaption }}</p>
    {% endif %}
  </div>
  {% endif %}

  <div class="article-body">
    {{ article.bodyHtml | safe }}
  </div>

  {% if article.author %}
  <div class="article-author">
    <span class="author-label">By</span>
    <div>
      <div class="author-name">{{ article.author.name }}</div>
      {% if article.author.bio %}
      <div class="author-bio">{{ article.author.bio }}</div>
      {% endif %}
    </div>
  </div>
  {% endif %}

</main>

<footer>
  <span class="footer-copy">San Diego, California</span>
  <span class="footer-copy">Eric Broadwater — Product Thinking for Everything</span>
  <span class="footer-copy">© 2026</span>
</footer>

</body>
</html>
